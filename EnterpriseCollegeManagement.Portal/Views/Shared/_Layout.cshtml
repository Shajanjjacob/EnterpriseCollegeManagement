
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Enterprise College Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseCollegeManagement.Portal.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold brand-name"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">E</span>
                    Enterprise <span>College Management</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="/#home">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#courses">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#faculty">Faculty</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#testimonials">Testimonials</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#contact">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mb-3 mb-lg-0">
                        <a class="btn btn-outline-primary px-4"
                           asp-controller="Account" asp-action="Login">
                            Login
                        </a>
                        <a class="btn btn-primary px-4"
                           asp-controller="Account" asp-action="Register">
                            Register
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-4">
            <div class="row align-items-center gy-3">
                <div class="col-md-7">
                    <h5 class="fw-bold mb-1">Enterprise College Management</h5>
                    <p class="mb-0 small">
                        Empowering students through knowledge and opportunity.
                    </p>
                </div>
                <div class="col-md-5 text-md-end">
                    <span class="small">
                        &copy; @DateTime.Now.Year Enterprise College Management
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
