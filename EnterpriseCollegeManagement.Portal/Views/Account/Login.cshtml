@model EnterpriseCollegeManagement.Portal.Models.LoginViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet"  href="~/css/account/login.css"  asp-append-version="true" />
}

<div class="container-fluid auth-page">
    <div class="container">
        <div class="row align-items-center min-vh-100 py-4">

            <!-- Left section: College information -->
            <div class="col-12 col-md-5 col-lg-4">
                <div class="auth-info-panel">
                    <h2>Welcome<br />Back!</h2>

                    <p>Continue your learning journey with us.</p>

                    <hr />

                    <div class="row align-items-center mb-4">
                        <div class="col-3">
                            <i class="bi bi-people-fill fs-2 text-primary"></i>
                        </div>
                        <div class="col-9">
                            <p class="mb-0">Connect with your college community</p>
                        </div>
                    </div>

                    <div class="row align-items-center mb-4">
                        <div class="col-3">
                            <i class="bi bi-book-half fs-2 text-primary"></i>
                        </div>
                        <div class="col-9">
                            <p class="mb-0">Access your academic resources</p>
                        </div>
                    </div>

                    <div class="row align-items-center mb-4">
                        <div class="col-3">
                            <i class="bi bi-mortarboard-fill fs-2 text-primary"></i>
                        </div>
                        <div class="col-9">
                            <p class="mb-0">Keep moving toward your goals</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right section: Login form -->
            <div class="col-12 col-md-7 col-lg-8">
                <div class="auth-form-section">

                    <!-- College branding -->
                    <div class="auth-brand">
                        <i class="bi bi-mortarboard-fill text-primary fs-1"></i>

                        <div>
                            <h1>Enterprise College</h1>
                            <p>Management System</p>
                        </div>
                    </div>

                    <!-- Login card -->
                    <div class="auth-card">
                        <h2 class="auth-title">Welcome Back</h2>

                        <p class="auth-subtitle">
                            Sign in to access your account
                        </p>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <form asp-controller="Account"  asp-action="Login" method="post">

                            @Html.AntiForgeryToken()  <!-- csrf  -->

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <!-- Email -->
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label"></label>

                                <input asp-for="Email" class="form-control"  placeholder="Enter email address" autocomplete="username" />

                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>

                                <div class="password-input-group">
                                    <input asp-for="Password" type="password" class="form-control"  placeholder="Enter password" autocomplete="current-password" />

                                    <button type="button" class="password-toggle" onclick="togglePassword('Password', this)" aria-label="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <!-- Forgot password -->
                            <div class="forgot-password-link">
                                <a asp-controller="Account" asp-action="ForgotPassword">
                                    Forgot password?
                                </a>
                            </div>

                            <!-- Login button -->
                            <button type="submit"
                                    class="btn btn-primary w-100 login-submit-btn">
                                Login
                            </button>
                        </form>

                        <!-- Google login -->
                        <div class="auth-divider">
                            <span></span>
                            <p>Or continue with</p>
                            <span></span>
                        </div>

                        <a href="@($"{Configuration["ApiSettings:GatewayBaseUrl"]?.TrimEnd('/')}/identity/api/Auth/google-login")"class="auth-google-btn">

                            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                                 alt="Google"
                                 width="21"
                                 height="21" />

                            <span>Continue with Google</span>
                        </a>

                        <!-- Register link -->
                        <p class="auth-switch-link">  Don't have an account?
                            <a asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
                button.setAttribute("aria-label", "Hide password");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
                button.setAttribute("aria-label", "Show password");
            }
        }
    </script>
}
