@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<section class="hero-section" id="home">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-7 hero-content">
                <span class="hero-badge">Empowering Education for a Better Tomorrow</span>

                <h1 class="display-4 fw-bold mt-4">
                    Build Your Future with
                    <span>Enterprise College Management</span>
                </h1>

                <p class="lead mt-3">
                    Explore exciting courses, learn from experienced faculty,
                    and become part of a vibrant academic community.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="#courses" class="btn btn-primary btn-lg">
                        Explore Courses
                    </a>
                    <a href="#about" class="btn btn-outline-light btn-lg">
                        Learn More
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Highlights -->
<section class="highlights-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-lg-3">
                <div class="highlight-item">
                    <div class="highlight-icon">01</div>
                    <div>
                        <h6>Quality Education</h6>
                        <p>Industry-relevant learning</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="highlight-item">
                    <div class="highlight-icon">02</div>
                    <div>
                        <h6>Expert Faculty</h6>
                        <p>Learn from professionals</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="highlight-item">
                    <div class="highlight-icon">03</div>
                    <div>
                        <h6>Modern Facilities</h6>
                        <p>Designed for learning</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="highlight-item">
                    <div class="highlight-icon">04</div>
                    <div>
                        <h6>Career Growth</h6>
                        <p>Prepare for your future</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Dummy statistics -->
<section class="stats-section">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-lg-3">
                <h2>5,000+</h2>
                <p>Students</p>
            </div>
            <div class="col-6 col-lg-3">
                <h2>50+</h2>
                <p>Courses</p>
            </div>
            <div class="col-6 col-lg-3">
                <h2>200+</h2>
                <p>Faculty Members</p>
            </div>
            <div class="col-6 col-lg-3">
                <h2>10+</h2>
                <p>Departments</p>
            </div>
        </div>
    </div>
</section>

<!-- About -->
<section class="section-padding" id="about">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="about-image">
                    <img src="https://placehold.co/800x550/e7eef7/17365d?text=College+Campus"
                         alt="Illustrative college campus"
                         class="img-fluid rounded-4 w-100" />
                </div>
            </div>

            <div class="col-lg-6">
                <span class="section-label">ABOUT OUR COLLEGE</span>
                <h2 class="section-title mt-2">
                    A Place to Learn, Grow and Achieve
                </h2>
                <p class="text-secondary mt-3">
                    Enterprise College Management represents a modern academic
                    environment focused on learning, innovation, collaboration,
                    and student development.
                </p>
                <p class="text-secondary">
                    Our illustrative college website brings academic information,
                    faculty details, and student resources together in one place.
                </p>
                <a href="#contact" class="btn btn-primary mt-2">
                    Learn About Us
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Courses -->
<section class="section-padding bg-light" id="courses">
    <div class="container">
        <div class="section-heading text-center mb-5">
            <span class="section-label">EXPLORE YOUR OPTIONS</span>
            <h2 class="section-title mt-2">Popular Courses</h2>
            <p class="text-secondary">
                Discover sample programs offered in our demonstration website.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="content-card h-100">
                    <div class="course-icon">CS</div>
                    <h5>Computer Science</h5>
                    <p class="text-secondary">
                        Explore programming, software engineering, and technology.
                    </p>
                    <a href="#contact" class="card-link">Explore course →</a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="content-card h-100">
                    <div class="course-icon">BA</div>
                    <h5>Business Administration</h5>
                    <p class="text-secondary">
                        Learn about management, business operations, and leadership.
                    </p>
                    <a href="#contact" class="card-link">Explore course →</a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="content-card h-100">
                    <div class="course-icon">EN</div>
                    <h5>Engineering</h5>
                    <p class="text-secondary">
                        Develop practical skills and solve real-world problems.
                    </p>
                    <a href="#contact" class="card-link">Explore course →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Faculty -->
<section class="section-padding" id="faculty">
    <div class="container">
        <div class="section-heading text-center mb-5">
            <span class="section-label">MEET OUR EDUCATORS</span>
            <h2 class="section-title mt-2">Our Faculty</h2>
            <p class="text-secondary">
                Example profiles for the landing page demonstration.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="faculty-card text-center">
                    <img src="https://placehold.co/120x120/e7eef7/17365d?text=SJ"
                         alt="Sample faculty profile"
                         class="faculty-avatar" />
                    <h5 class="mt-3">Dr. Sarah Johnson</h5>
                    <p class="text-secondary mb-0">Computer Science</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="faculty-card text-center">
                    <img src="https://placehold.co/120x120/e7eef7/17365d?text=MB"
                         alt="Sample faculty profile"
                         class="faculty-avatar" />
                    <h5 class="mt-3">Prof. Michael Brown</h5>
                    <p class="text-secondary mb-0">Business Administration</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="faculty-card text-center">
                    <img src="https://placehold.co/120x120/e7eef7/17365d?text=ED"
                         alt="Sample faculty profile"
                         class="faculty-avatar" />
                    <h5 class="mt-3">Dr. Emily Davis</h5>
                    <p class="text-secondary mb-0">Engineering</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="section-padding bg-light" id="testimonials">
    <div class="container">
        <div class="section-heading text-center mb-5">
            <span class="section-label">STUDENT EXPERIENCES</span>
            <h2 class="section-title mt-2">What Students Say</h2>
        </div>

        <div class="row justify-content-center g-4">
            <div class="col-md-6 col-lg-4">
                <div class="testimonial-card h-100">
                    <div class="testimonial-stars">★★★★★</div>
                    <p>
                        "The supportive learning environment helped me grow
                        my skills and confidence."
                    </p>
                    <h6 class="mb-1">Alex Carter</h6>
                    <small class="text-secondary">Sample student testimonial</small>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="testimonial-card h-100">
                    <div class="testimonial-stars">★★★★★</div>
                    <p>
                        "I enjoyed learning new concepts and working on
                        practical academic projects."
                    </p>
                    <h6 class="mb-1">Jamie Wilson</h6>
                    <small class="text-secondary">Sample student testimonial</small>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="testimonial-card h-100">
                    <div class="testimonial-stars">★★★★★</div>
                    <p>
                        "The faculty and collaborative atmosphere made
                        learning an enjoyable experience."
                    </p>
                    <h6 class="mb-1">Taylor Morgan</h6>
                    <small class="text-secondary">Sample student testimonial</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact / CTA -->
<section class="section-padding" id="contact">
    <div class="container">
        <div class="cta-section text-center">
            <h2>Ready to Start Your Academic Journey?</h2>
            <p>
                Take the first step towards learning, growth, and new opportunities.
            </p>
            <a asp-controller="Account" asp-action="Register"
               class="btn btn-light btn-lg mt-3">
                Get Started →
            </a>
        </div>
    </div>
</section>
