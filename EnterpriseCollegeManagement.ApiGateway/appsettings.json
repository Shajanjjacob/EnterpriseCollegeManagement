{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "student-route": {
        "ClusterId": "student-cluster",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "/students/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/students" }
        ]
      },
      "academic-route": {
        "ClusterId": "academic-cluster",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "/academic/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/academic" }
        ]
      },
      "teacher-route": {
        "ClusterId": "teacher-cluster",
        "Timeout": "00:00:10",  //downstream time out 
        "Match": {
          "Path": "/teachers/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/teachers" }
        ]
      },
      "assignment-route": {
        "ClusterId": "assignment-cluster",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "/assignments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/assignments" }
        ]
      }
    },
    "Clusters": {}
  }
}
